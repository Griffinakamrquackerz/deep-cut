# ── LLM (taste profiles + rec reasoning) ────────────────────────────
# Default provider is any OpenAI-compatible endpoint. Ships pointed at
# Groq's free tier. Server-side only — never NEXT_PUBLIC.
#
# Groq (free tier, fast):     https://console.groq.com  → key below as-is
# OpenRouter (free routes):   LLM_BASE_URL=https://openrouter.ai/api/v1
#                             LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
# DeepSeek (cheap, strong):   LLM_BASE_URL=https://api.deepseek.com/v1
#                             LLM_MODEL=deepseek-chat
# Local vLLM/Ollama:          LLM_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Auto-used when the primary model is rate-limited (free quotas are per-model)
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Optional: switch back to Anthropic with LLM_PROVIDER=anthropic
# (uses ANTHROPIC_API_KEY; LLM_MODEL defaults to claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# TMDB — metadata, posters, search, watch providers (v3 API key or v4 read token)
TMDB_API_KEY=

# OMDb (OPTIONAL) — adds IMDb + Rotten Tomatoes ratings. Free key:
# https://www.omdbapi.com/apikey.aspx  (leave blank to use TMDB's rating only)
OMDB_API_KEY=

# Supabase — auth + Postgres + storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for share links / OG images (e.g. https://deepcut.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily per-user caps (product guardrails, NOT cost limits — free tiers have no
# spend). Raise for a personal instance; set 9999 for effectively unlimited.
DAILY_REC_BATCHES=25
DAILY_PROFILE_REGENS=10

# ── Balcony Seats (premium via Stripe) — optional until launch ─────────
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=
# Price ID of the $4.99/mo recurring price (price_...)
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Free-tier daily deal cap (premium uses DAILY_REC_BATCHES, default 30)
DAILY_REC_BATCHES_FREE=10

# ── Web push (Friday Night Deal) — optional until launch ───────────────
# Generate a keypair ONCE:   npx web-push generate-vapid-keys
# The whole feature no-ops cleanly until these are set (Settings toggle hides).
# Also requires migration 0005 (push_subscriptions table) to be applied.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@thedeepcut.xyz
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# Set the SAME value in the Vercel project's env so the cron route accepts it.
CRON_SECRET=
# NOTE for the iOS app wrapper: web push works in the installed PWA on iOS 16.4+;
# a native App Store build needs APNs configured under your Apple Developer team.
