# ── LLM (taste profiles + rec reasoning) ────────────────────────────
# Default provider is any OpenAI-compatible endpoint. Ships pointed at
# Groq's free tier. Server-side only — never NEXT_PUBLIC.
#
# Groq (free tier, fast):     https://console.groq.com  → key below as-is
# OpenRouter (free routes):   LLM_BASE_URL=https://openrouter.ai/api/v1
#                             LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
# DeepSeek (cheap, strong):   LLM_BASE_URL=https://api.deepseek.com/v1
#                             LLM_MODEL=deepseek-chat
# Local vLLM/Ollama:          LLM_BASE_URL=http://localhost:11434/v1
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Auto-used when the primary model is rate-limited (free quotas are per-model)
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Optional: switch back to Anthropic with LLM_PROVIDER=anthropic
# (uses ANTHROPIC_API_KEY; LLM_MODEL defaults to claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# TMDB — metadata, posters, search, watch providers (v3 API key or v4 read token)
TMDB_API_KEY=

# OMDb (OPTIONAL) — adds IMDb + Rotten Tomatoes ratings. Free key:
# https://www.omdbapi.com/apikey.aspx  (leave blank to use TMDB's rating only)
OMDB_API_KEY=

# Supabase — auth + Postgres + storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for share links / OG images (e.g. https://deepcut.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily per-user caps (product guardrails, NOT cost limits — free tiers have no
# spend). Raise for a personal instance; set 9999 for effectively unlimited.
DAILY_REC_BATCHES=25
DAILY_PROFILE_REGENS=10
